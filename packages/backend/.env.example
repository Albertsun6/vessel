# 走 claude CLI 子进程 + 你已登录的订阅 (~/.claude/.credentials.json)
# 不需要 ANTHROPIC_API_KEY
PORT=3030

# 可选：覆盖 claude CLI 路径（默认 PATH 中的 `claude`）
# CLAUDE_CLI=/Users/yongqian/.local/bin/claude

# ── ASR 语音转文字 ──────────────────────────────────────────────────────────
# Provider 优先级（auto 模式）: iflytek → groq → whisper-cpp（本地）
# 显式指定：ASR_PROVIDER=iflytek|groq|whisper-cpp|auto（默认 auto）
# ASR_PROVIDER=auto

# 讯飞开放平台（xfyun.cn → 控制台 → 创建应用 → 语音听写）
# IFLYTEK_APPID=xxxxxxxx
# IFLYTEK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# IFLYTEK_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq（console.groq.com → API Keys）
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 默认 whisper-large-v3（最准）；可改 whisper-large-v3-turbo 省额度
# GROQ_MODEL=whisper-large-v3

# 本地 whisper-cli（默认，无需配置；覆盖路径/模型用下面两行）
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=/Users/yongqian/.whisper-models/ggml-large-v3-turbo-q5_0.bin

